<?php
	// connect.php
	error_reporting(E_ALL);
	ini_set('display_errors', 0);
	ini_set('log_errors', 1);
	ini_set('error_log', __DIR__ . '/php-error.log');
	
	// ✅ Start session
	if (session_status() === PHP_SESSION_NONE) {
		$isLocalhost = isset($_SERVER['HTTP_HOST']) && (strpos($_SERVER['HTTP_HOST'], 'localhost') !== false || strpos($_SERVER['HTTP_HOST'], '127.0.0.1') !== false);
		if (!$isLocalhost) {
			ini_set('session.cookie_domain', '.[YOUR_DOMAIN]');
			ini_set('session.cookie_secure', 1);
		}
		ini_set('session.cookie_path', '/');
		ini_set('session.cookie_httponly', 1);
		ini_set('session.use_strict_mode', 1);
		ini_set('session.use_only_cookies', 1);
		ini_set('session.gc_maxlifetime', 86400);
		ini_set('session.cookie_lifetime', 0);
		ini_set('session.gc_probability', 1);
		ini_set('session.gc_divisor', 100);

		session_start();
	}

	// ✅ Auto-logout check
	require("auto-logout.php");

	// --- Database connection ---
	define('DB_HOST', 'YOUR_DB_HOST');
	define('DB_USER', 'YOUR_DB_USER');
	define('DB_PASS', 'YOUR_DB_PASS');
	define('DB_NAME', 'YOUR_DB_NAME');

	$conn = mysqli_connect(DB_HOST, DB_USER, DB_PASS, DB_NAME);
	if ($conn === false) {
		die("ERROR: Could not connect. " . mysqli_connect_error());
	}
	$conn->set_charset("utf8mb4");

	// ✅ Update user last_active timestamp if logged in
	if (isset($_SESSION['user'])) {
		$updateActiveStmt = $conn->prepare("UPDATE users SET last_active = NOW() WHERE username = ?");
		if ($updateActiveStmt) {
			$updateActiveStmt->bind_param("s", $_SESSION['user']);
			$updateActiveStmt->execute();
			$updateActiveStmt->close();
		}
	}
?>
